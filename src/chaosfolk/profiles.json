    {
      "id": "copy-paster",
      "nom": "Copy-paster",
      "habitudes": [
        "pastes text from another document",
        "expects whitespace and Unicode to survive"
      ],
      "manies": [
        "pastes synthetic names with leading and trailing spaces",
        "uses accented characters and emoji in permitted text fields",
