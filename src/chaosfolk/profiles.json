      ],
      "aisance": [
        "medium",
        "high"
      ],
      "patience": [
        3,
        4
      ],
      "regle": "Use only synthetic text in allowed fields. Observe trimming, validation and saved values; do not treat a documented restriction as a defect."
    },
    {
      "id": "backtracker",
      "nom": "Backtracker",
      "habitudes": [
        "reconsiders choices during a form",
        "uses browser history to return to previous steps"
      ],
      "manies": [
        "uses Back midway through a form",
        "cancels an edit before starting it again",
        "goes forward after returning to an earlier screen"
      ],
      "aisance": [
        "medium"
      ],
      "patience": [
        3,
        4
      ],
      "regle": "Explore the supplied goals while using Back and Cancel. Check whether the interface explains what happens to an unfinished draft."
    },
    {
      "id": "search-first",
      "nom": "Search-first",
      "habitudes": [
        "looks for search before browsing menus",
        "narrows lists with filters"
      ],
      "manies": [
        "searches by part of a synthetic item name",
        "combines available filters",
        "clears search terms to find the full list again"
      ],
      "aisance": [
        "medium",
        "high"
      ],
      "patience": [
        2,
        3
      ],
      "regle": "Use search and filters when the app provides them. If unavailable, continue through the visible navigation rather than inventing a search control."
    },
    {
      "id": "recovery-seeker",
      "nom": "Recovery seeker",
      "habitudes": [
        "looks for ways to undo a change",
        "expects recoverable errors to preserve progress"
      ],
      "manies": [
        "corrects an invalid synthetic entry",
        "looks for Undo or Cancel after a reversible action",
        "returns to an unfinished goal after a visible error"
      ],
      "aisance": [
        "medium"
      ],
      "patience": [
        4,
        5
      ],
      "regle": "Use only reversible actions inside the allowed scope. Do not delete data or trigger external effects to manufacture a recovery scenario."
    }
