# Copy to /etc/chaosfolk-web.env (mode 0600, owner root). Read by both systemd services.

# OpenRouter key used by the runner containers. Set a credit limit on this key in OpenRouter.
OPENROUTER_API_KEY=
# OpenCode model id, "openrouter/<vendor>/<model>". Choose a model that supports tool calls.
CHAOSFOLK_WEB_MODEL=

# Public address of this server, used in report links.
CHAOSFOLK_WEB_PUBLIC_URL=https://audit.example.com
# Landing page origins allowed to call the API (comma separated).
CHAOSFOLK_WEB_ALLOWED_ORIGINS=https://loukan42.github.io
# Cloudflare Turnstile secret key. The matching site key goes in site/config.js.
CHAOSFOLK_WEB_TURNSTILE_SECRET=
# Caddy sets X-Real-IP; keep 1 when the API is only reachable through Caddy.
CHAOSFOLK_WEB_TRUST_PROXY=1

CHAOSFOLK_WEB_DATA=/var/lib/chaosfolk-web
CHAOSFOLK_WEB_DAILY_QUOTA=5
CHAOSFOLK_WEB_PER_IP_DAILY=1
CHAOSFOLK_WEB_AUDIT_MINUTES=10
CHAOSFOLK_WEB_MAX_ACTIONS=80
CHAOSFOLK_WEB_USERS=3
CHAOSFOLK_WEB_REPORT_DAYS=7

CHAOSFOLK_WEB_RUNNER=docker
CHAOSFOLK_WEB_RUNNER_IMAGE=chaosfolk-runner
CHAOSFOLK_WEB_RUNNER_NETWORK=chaosfolk-audits
