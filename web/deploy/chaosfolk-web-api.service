[Unit]
Description=Chaosfolk hosted audits: public API
After=network-online.target
Wants=network-online.target

[Service]
User=chaosfolk-web
Group=chaosfolk-web
EnvironmentFile=/etc/chaosfolk-web.env
# The API never needs the model key.
UnsetEnvironment=OPENROUTER_API_KEY
WorkingDirectory=/opt/chaosfolk/web
ExecStart=/opt/chaosfolk/web/.venv/bin/python -m uvicorn chaosfolk_web.app:create_app --factory --host 127.0.0.1 --port 8000 --no-proxy-headers
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/chaosfolk-web

[Install]
WantedBy=multi-user.target
